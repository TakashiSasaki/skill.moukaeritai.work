{
  "@context": {
    "core": "https://example.org/vocab/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "DocumentRecord": "core:DocumentRecord",
    "id": "core:id",
    "title": "core:title",
    "createdAt": {
      "@id": "core:createdAt",
      "@type": "xsd:dateTime"
    },
    "tags": {
      "@id": "core:tag",
      "@container": "@set"
    }
  }
}